      "name": "Fetch hourly load outages submitted to AESO",
      "request": {
        "name": "Fetch hourly load outages submitted to AESO",
        "description": {
          "content": "Fetch hourly load outage forecast for a given date or date range. \r\nIf only the startDate is provided, data will only be provided for that day. \r\n",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "loadOutageReport"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "disabled": false,
              "key": "startDate",
              "value": "<string>",
              "description": "(Required) Date (yyyy-mm-dd) from 2013-09-22, and up to 24 months in the future."
            },
            {
              "disabled": false,
              "key": "endDate",
              "value": "<string>",
              "description": "Date (yyyy-mm-dd) equal or after startDate, and up to 24 months in the future. If blank, data for the startDate will be returned."
            }
          ],
          "variable": []
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "method": "GET",
