  "item": [
    {
      "id": "2580c467-0d75-4248-ada9-5b6326e86c39",
      "name": "Fetch Energy Merit Order snapshot data for a given date that is 60 days prior to current date.",
      "request": {
        "name": "Fetch Energy Merit Order snapshot data for a given date that is 60 days prior to current date.",
        "description": {
          "content": "Fetch Energy Merit Order snapshot data for Date(startDate (yyyy-MM-dd)) \n\nThe EMMO snapshot data is available 60 days after the date of the snapshot, first available from September 1, 2009. \n\nThe data from 1-Sep-2009 to 1-Sep-2014 is the Merit Order at the 30th min. of the settlement interval. \n\nThe data after 1-Sep-2014 is the last Merit Order of the settlement interval.\r\n",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "meritOrder",
            "energy"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "disabled": false,
              "key": "startDate",
              "value": "<string>",
              "description": "(Required) Any date between 2009-09-01 and 60 days prior to current date (format: yyyy-MM-dd)."
            }
          ],
          "variable": []
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "method": "GET",
        "auth": null
      },
      "response": [
        {
          "id": "d608693f-3ac6-444c-bf60-317f2995f192",
          "name": "OK",
