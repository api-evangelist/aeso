          "body": "{\n  \"data\": [\n    {\n      \"begin_dateTime_utc\": \"string\",\n      \"begin_dateTime_mpt\": \"string\",\n      \"energy_blocks\": [\n        {\n          \"import_or_export\": \"string\",\n          \"asset_ID\": \"string\",\n          \"block_number\": 0,\n          \"block_price\": 0,\n          \"from_MW\": 0,\n          \"to_MW\": 0,\n          \"block_size\": 0,\n          \"available_MW\": 0,\n          \"dispatched?\": \"string\",\n          \"dispatched_MW\": 0,\n          \"flexible?\": \"string\",\n          \"offer_control\": \"string\"\n        }\n      ]\n    }\n  ]\n}",
