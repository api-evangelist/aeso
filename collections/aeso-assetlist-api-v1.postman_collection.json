      "id": "352c4bea-9cd0-4d6b-8d3f-1f7590b5db1f",
      "name": "Fetch the latest list of assets connected to AIES.",
      "request": {
        "name": "Fetch the latest list of assets connected to AIES.",
        "description": {
          "content": " The asset_ID and pool_participant_ID parameters are comma separated lists. At most, one of the two parameters can be passed in an API call.\n\nNote: The Operating Status, Pool Participant Name and ID for an asset can change overtime.",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "assetlist"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "disabled": false,
              "key": "asset_ID",
              "value": "<string>",
              "description": "This parameter can contain up to 20 comma-separated Asset IDs."
            },
            {
              "disabled": false,
              "key": "pool_participant_ID",
              "value": "<string>",
              "description": "This parameter can contain up to 20 comma-separated Pool Participant IDs."
            },
            {
              "disabled": false,
              "key": "operating_status",
              "value": "ALL",
              "description": "The allowed values are ACTIVE, RETIRED, SUSPENDED, INACTIVE"
            },
            {
              "disabled": false,
              "key": "asset_type",
              "value": "ALL",
              "description": "The allowed values are SOURCE, SINK"
            }
          ],
          "variable": []
        },
