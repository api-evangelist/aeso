      "name": "Fetch Unit Commitment Directive Data",
      "request": {
        "name": "Fetch Unit Commitment Directive Data",
        "description": {
          "content": "Fetch generating unit commitment directive data for a date range",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "unitCommitment"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "disabled": false,
              "key": "startDate",
              "value": "<string>",
              "description": "Unit Commitment End Date From. Any date from 2024-07-01. Default to current time if left blank (format: yyyy-MM-dd).)"
            },
            {
              "disabled": false,
              "key": "endDate",
              "value": "<string>",
              "description": "Unit Commitment End Date To. Any date from 2024-07-01 but after startDate. If left blank, return all the data from startDate. (format: yyyy-MM-dd).)"
            }
          ],
          "variable": []
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "method": "GET",
