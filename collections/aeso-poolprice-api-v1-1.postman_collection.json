  "item": [
    {
      "id": "81689702-454d-462f-898b-dfdd5616d493",
      "name": "Fetch pool price report for a given date range",
      "request": {
        "name": "Fetch pool price report for a given date range",
        "description": {
          "content": "Fetch pool price report for the date range: startDate (yyyy-mm-dd) to endDate (yyyy-mm-dd). The endDate is optional. If endDate is omitted, fetched data will include the pool price values for all the completed settlement hours of the day specified by startDate.\r\n\r\nTo fetch the latest pool price, include the date of that hour in your query.\r\n\r\n \r\n\r\nThe API will return data for a maximum of 1 year at a time.",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "price",
            "poolPrice"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "disabled": false,
              "key": "startDate",
              "value": "<string>",
              "description": "(Required) Any date between 2000-01-01 and current date.  (format: yyyy-MM-dd)."
            },
            {
              "disabled": false,
              "key": "endDate",
              "value": "<string>",
              "description": "Any date up to current date but after startDate. If left blank, only data for startDate will be returned. (format: yyyy-MM-dd)."
            }
          ],
          "variable": []
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "method": "GET",
        "auth": null
      },
